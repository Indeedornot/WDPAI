{
  "name": "my-ts-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsc && esbuild src/test/run.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test/run.mjs && node node_modules/.cache/test/run.mjs",
    "test:smoke": "tsc && esbuild src/test/bootstrap.smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test/smoke.mjs && node node_modules/.cache/test/smoke.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.4.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.1"
  }
}
