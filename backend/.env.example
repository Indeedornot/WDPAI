; Use either DATABASE_URL or POSTGRES_* variables.
; Example: postgres://user:pass@localhost:5432/mydb
DATABASE_URL=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

; Comma-separated list for CORS. Use * only for local dev.
CORS_ORIGINS=http://localhost:5173

; Set to true in production to enforce HTTPS on auth endpoints.
REQUIRE_HTTPS=false

; Optional: prefix for routes (e.g. /api). Keep empty by default.
BASE_PATH=

; Set to true to load db/seed.sql (idempotent sample data) after migrations
; on startup. Handy for graders/local demos; leave false in production.
SEED_ON_START=false
