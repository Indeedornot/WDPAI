; Use either DATABASE_URL or MYSQL_* variables.
; Example: mysql://user:pass@localhost:3306/mydb
DATABASE_URL=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mydb
MYSQL_USER=root
MYSQL_PASSWORD=

; Comma-separated list for CORS. Use * only for local dev.
CORS_ORIGINS=http://localhost:5173

; Optional: prefix for routes (e.g. /api). Keep empty by default.
BASE_PATH=
